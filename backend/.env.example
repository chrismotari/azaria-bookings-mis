SECRET_KEY=change-me-to-a-long-random-string-of-50-characters
DEBUG=True
DATABASE_URL=postgres://azaria:password@localhost:5432/azaria
REDIS_URL=redis://localhost:6379/0
# Trusted proxies in front of the API (0 when clients connect directly); the throttles use the real client IP.
NUM_PROXIES=0
ALLOWED_HOSTS=localhost,.localhost
CORS_ALLOWED_ORIGIN_REGEXES=^http://([a-z0-9-]+\.)?localhost:8081$
# The web app's base URL; {domain} is the agency's app address (<code>.<TENANT_BASE_DOMAIN>), used in every email link.
FRONTEND_URL=http://{domain}:8081
# The root host: the platform (public schema). Agencies are reached at <schema>.<this>.
TENANT_BASE_DOMAIN=localhost
# Optional: the mobile app, for the link verification files under /.well-known/ (404 while unset).
# Apple Team ID plus bundle id, e.g. ABCDE12345.com.azariabookings.app
IOS_APP_ID=
ANDROID_PACKAGE=
# SHA-256 fingerprints of the Android signing certificates, comma-separated.
ANDROID_CERT_FINGERPRINTS=

# Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Azaria Bookings <no-reply@azariabookings.com>
# Seeds AppSettings.admin_notification_email on first migrate.
ADMIN_EMAIL=you@example.com
# Currency of the platform's plans and invoices (what agencies pay the platform).
PLATFORM_CURRENCY=USD
# Encrypts fare providers' credentials (a Fernet key). Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_KEY=
# Optional: the daily USD exchange-rate feed (ExchangeRate-API's open-access format).
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD
