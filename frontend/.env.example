# {host}: the page's hostname on the web; the stored agency's address (<code>.<base>) in the mobile app.
EXPO_PUBLIC_API_URL=http://{host}:8000/api
# Agencies are reached at <code>.<this> (the backend's TENANT_BASE_DOMAIN); the mobile app's links and API use it.
EXPO_PUBLIC_TENANT_BASE_DOMAIN=localhost
# Store pages for the "Get the app" page (buttons are hidden while unset).
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# The root host: the platform where the system owner manages agencies (web only).
EXPO_PUBLIC_PLATFORM_HOST=localhost
